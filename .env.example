# ─────────────────────────────────────────────────────────────────────────────
# GCUF Result Portal — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env (or any file with real secrets) to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # "production" enables strict CORS and secure cookies
PORT=8080                     # Set automatically by Replit; override for local dev

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Set automatically by Replit managed PostgreSQL.

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# ── Admin seed credentials ────────────────────────────────────────────────────
# Used ONCE on startup to create the initial admin account if it does not exist.
# After the account is created, these values are no longer used.
# Password must meet the strong password policy enforced at user creation time.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change_Me_Now!9

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production.
# Example: https://app.example.com,https://www.example.com
# If not set and NODE_ENV=development, all origins are permitted (dev convenience).
# REQUIRED in production — omitting this in production blocks all cross-origin requests.
ALLOWED_ORIGINS=https://your-app.replit.app

# ── PII Encryption (optional but recommended) ─────────────────────────────────
# AES-256-GCM key for encrypting sensitive fields (CNIC) at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes).
# If not set, CNIC values are stored as plaintext (backward-compatible).
# Once set, new records are encrypted automatically; existing records remain
# plaintext until re-encrypted with a migration script.
ENCRYPTION_KEY=
